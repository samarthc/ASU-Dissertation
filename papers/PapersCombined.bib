  file = {/Users/samarth/Zotero/storage/4CDWXC2P/Aliev (2007) - Electromagnetic Properties of Kerr-Anti-de Sitter Black Holes.pdf;/Users/samarth/Zotero/storage/4AQ2RXT6/0702129.html}
}

@article{Alkac:2021bav,
