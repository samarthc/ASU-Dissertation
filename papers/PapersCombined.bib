  author = {Hong, Kenneth and Teo, Edward},
  date = {2003-07-21},
  journaltitle = {Classical and Quantum Gravity},
  shortjournal = {Class. Quant. Grav.},
  volume = {20},
  number = {14},
  eprint = {gr-qc/0305089},
