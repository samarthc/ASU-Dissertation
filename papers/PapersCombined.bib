@article{Krtous:2018bvk,
  title = {Separation of {{Maxwell}} Equations in {{Kerr-NUT-}}({{A}}){{dS}} Spacetimes},
  author = {Krtouš, Pavel and Frolov, Valeri P. and Kubizňák, David},
  date = {2018-09},
  journaltitle = {Nuclear Physics B},
