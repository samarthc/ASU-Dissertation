@article{Lee:2018gxc,
  title = {Kerr-{{Schild Double Field Theory}} and {{Classical Double Copy}}},
  author = {Lee, Kanghoon},
  date = {2018-10},
  journaltitle = {Journal of High Energy Physics},
  shortjournal = {J. High Energ. Phys.},
  volume = {2018},
