@article{Han:2022mze,
  title = {The {{Weyl}} Double Copy in Vacuum Spacetimes with a Cosmological Constant},
  author = {Han, Shanzhong},
  date = {2022-09-20},
  journaltitle = {Journal of High Energy Physics},
  shortjournal = {JHEP},
  volume = {2022},
  number = {09},
  eprint = {2205.08654},
  eprinttype = {arXiv},
  eprintclass = {astro-ph, physics:gr-qc, physics:hep-th},
  pages = {238},
  doi = {10.1007/JHEP09(2022)238},
  url = {http://arxiv.org/abs/2205.08654},
  urldate = {2022-10-19},
  abstract = {We examine the Weyl double copy relation for vacuum solutions of the Einstein equations with a cosmological constant using the approach we previously described, in which the spin-1/2 massless free-field spinors (Dirac-Weyl fields) are regarded as basic units. Based on the exact non-twisting vacuum type N and vacuum type D solutions, the finding explicitly shows that the single and zeroth copies fulfill conformally invariant field equations in conformally flat spacetime. In addition, irrespective of the presence of a cosmological constant, we demonstrate that the zeroth copy connects Dirac-Weyl fields with the degenerate electromagnetic fields in the curved spacetime in addition to connecting gravity fields with the single copy in conformally flat spacetime. Moreover, the study also demonstrates the critical significance the zeroth copy plays in time-dependent radiation solutions. In particular, for Robinson-Trautman (\$\textbackslash Lambda\$) gravitational waves, unlike the single copy, we find that the zeroth copy carries additional information to specify whether the sources of associated gravitational waves are time-like, null, or space-like, at least in the weak field limit.},
  langid = {english},
  version = {2},
  keywords = {Astrophysics - High Energy Astrophysical Phenomena,Black Holes,Black Holes in String Theory,Classical Double Copy Formalism,Classical Theories of Gravity,cosmological constant,Double Copy Flat vs Curved Background,field equations,Gauge-Gravity Correspondence,General Relativity and Quantum Cosmology,gravitation,gravitational radiation,High Energy Physics - Theory,radiation: time dependence,spinor: Dirac,spinor: massless,spinor: Weyl,symmetry: space-time,vacuum: solution},
  file = {/Users/samarth/Zotero/storage/STXXBR6Z/Han (2022) - The Weyl double copy in vacuum spacetimes with a cosmological constant.pdf;/Users/samarth/Zotero/storage/D4ETM3E9/2205.html}
}

@article{Han:2022ubu,
  title = {Weyl Double Copy and Massless Free Fields in Curved Spacetimes},
  author = {Han, Shanzhong},
  date = {2022-04-04},
  journaltitle = {Class. Quant. Grav.},
  shortjournal = {Class. Quant. Grav.},
  volume = {39},
  number = {22},
  eprint = {2204.01907},
  eprinttype = {arXiv},
  eprintclass = {gr-qc, physics:hep-th},
  pages = {225009},
  doi = {10.1088/1361-6382/ac96c2},
  url = {http://arxiv.org/abs/2204.01907},
  urldate = {2022-09-11},
  abstract = {Based on the fact that any massless free-field with spin higher than \$\textbackslash frac\{1\}\{2\}\$ can be constructed from scalar fields (spin-0) and Dirac-Weyl fields (spin-\$\textbackslash frac\{1\}\{2\}\$), we introduce a map between spin-\$2\$ massless free-fields (gravity fields) and spin-\$\textbackslash frac\{1\}\{2\}\$ massless free-fields (Dirac-Weyl fields) in spinor formalism. The associated Dirac-Weyl spinors can live in certain spacetime are identified. Regarding them as basic units, other higher spin massless free-fields are then constructed. In this way, some hidden fundamental features related to massless-free fields are revealed. In particular, for type N vacuum spacetimes, we show that all higher spin massless free-fields can be constructed by the same type of Dirac-Weyl spinors and an auxiliary scalar field, which satisfies the wave equation not only on curved spacetime but also on Minkowski spacetime. For type D vacuum spacetimes, we show that there exist similar relationships among different spin massless free-fields. Furthermore, we systematically rebuild the Weyl double copy for non-twisting type N vacuum spacetimes and type D vacuum spacetimes. We show that the zeroth copy not only connects the gravity fields with a single copy but also connects those degenerate electromagnetic fields with the Dirac-Weyl fields living in the curved spacetime, both for type N and type D cases. Afterward, we extend the study to type III non-twisting vacuum solutions. Independent of the proposed map, we find that there is a special Dirac-Weyl scalar whose square is just proportional to the Weyl scalar. A degenerate Maxwell field and an auxiliary scalar field are then solved. Both of them play the similar roles as the double copy. The result further confirms that there must exist a deep connection between gravity theory and gauge theory.},
  keywords = {Double Copy Flat vs Curved Background,electromagnetic field,field theory: scalar: massless,gauge theory,General Relativity and Quantum Cosmology,gravitation,High Energy Physics - Theory,massless free-fields,Minkowski,scalar: Weyl,space-time,spin: high,spinor formalism,spinor: Dirac,spinor: Weyl,vacuum type D solutions,vacuum type III solutions,vacuum type N solutions,vacuum: solution,Weyl double copy},
  file = {/Users/samarth/Zotero/storage/SZ89GNUL/Han (2022) - Weyl double copy and massless free fields in curved spacetimes.pdf;/Users/samarth/Zotero/storage/VTC5LJAT/2204.html}
}

