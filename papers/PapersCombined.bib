@article{Aliev:2007qi,
  title = {Electromagnetic {{Properties}} of {{Kerr-Anti-de Sitter Black Holes}}},
  author = {Aliev, Alikram N.},
  date = {2007-04-30},
  journaltitle = {Physical Review D},
  shortjournal = {Phys. Rev. D},
