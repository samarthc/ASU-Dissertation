@article{Elor:2020nqe,
  title = {The {{Newman-Penrose Map}} and the {{Classical Double Copy}}},
  author = {Elor, Gilly and Farnsworth, Kara and Graesser, Michael L. and Herczeg, Gabriel},
  date = {2020-07-28},
  journaltitle = {Journal of High Energy Physics},
