  file = {/Users/samarth/Zotero/storage/KZFI7MI9/Ortaggio et al (2013) - Algebraic classification of higher dimensional spacetimes based on null.pdf;/Users/samarth/Zotero/storage/MHFTIMTI/1211.html}
