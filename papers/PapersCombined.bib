@article{Monteiro:2020plf,
  title = {Classical {{Solutions}} and Their {{Double Copy}} in {{Split Signature}}},
  author = {Monteiro, Ricardo and O'Connell, Donal and Veiga, David Peinador and Sergola, Matteo},
  date = {2021-05},
  journaltitle = {Journal of High Energy Physics},
